# Copy to .env.local and fill in real values. Never commit .env.local.

# Database (placeholder; the ORM is chosen in step 3)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/briddhi_uni"

# Session signing secret: generate with `openssl rand -base64 32`
AUTH_SECRET="replace-me"

# OTP provider: "mock" logs codes to the server console; a real SMS gateway plugs in later
OTP_PROVIDER="mock"
SMS_GATEWAY_API_KEY=""

# Admin allowlist: comma-separated E.164 numbers. Real numbers go in .env.local only.
ADMIN_PRODUCER_PHONES="+8801XXXXXXXXX"
ADMIN_UNI_LEAD_PHONES="+8801XXXXXXXXX"

# Public site URL, used for share cards and OG images
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
